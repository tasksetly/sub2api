<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Tasksetly 为 Codex CLI 提供按量计费的 API 接入。注册后可通过站内工单申请 3 美元体验兑换码。">
    <link rel="canonical" href="https://ai.tasksetly.com/go/codex">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Codex CLI API 接入与价格 | Tasksetly">
